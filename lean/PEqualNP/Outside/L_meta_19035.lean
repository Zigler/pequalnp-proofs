def ckt : Circuit := ⟨cktGates, 2299⟩

def getRev (rw : List ℕ) (n i : ℕ) : ℕ :=
  if i < n then rw.getD (n - 1 - i) 0 else 0

def initList : List ℕ :=
  List.ofFn (fun i : Fin 128 => mask32 <<< (128 * i.val)) ++
  List.ofFn (fun j : Fin 128 => colPat <<< j.val)

def getW (rw : List ℕ) (n i : ℕ) : ℕ :=
  if i < 256 then initList.getD i 0 else getRev rw n i

def stepRev (st : ℕ × List ℕ) (g : Gate) : ℕ × List ℕ :=
  let n := st.1
  let rw := st.2
  let v :=
    match g.op, g.inputs with
    | GateOp.and, [a, b] => (getW rw n a) &&& (getW rw n b)
    | GateOp.or, [a, b] => (getW rw n a) ||| (getW rw n b)
    | GateOp.not, [a] => mask1024 ^^^ (getW rw n a)
    | _, _ => 0
  (n + 1, v :: rw)

def initRev : List ℕ := initList.reverse

def goodGate (g : Gate) : Bool :=
  match g.op, g.inputs with
  | GateOp.and, [_, _] => true
  | GateOp.or, [_, _] => true
  | GateOp.not, [_] => true
  | _, _ => false

theorem mask1024_bit (k : ℕ) (hk : k < 16384) : mask1024.testBit k = true := by
  have h : mask1024 = 2 ^ 16384 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true hk

theorem mask32_bit (k : ℕ) (hk : k < 128) : mask32.testBit k = true := by
  have h : mask32 = 2 ^ 128 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_true hk

theorem mask32_bit_ge (k : ℕ) (hk : 128 ≤ k) : mask32.testBit k = false := by
  have h : mask32 = 2 ^ 128 - 1 := rfl
  rw [h, Nat.testBit_two_pow_sub_one]
  exact decide_eq_false (by omega)

theorem colPat_bit (u : Fin 128) (v : Fin 128) (j : Fin 128) :
    (colPat <<< j.val).testBit (128 * u.val + v.val) = decide (j = v) := by
  rw [Nat.testBit_shiftLeft]
  by_cases hle : j.val ≤ 128 * u.val + v.val
  · simp only [decide_eq_true hle, Bool.true_and]
    have hmod : (128 * u.val + v.val - j.val) % 128 = (128 + v.val - j.val) % 128 := by omega
    have hlt : 128 * u.val + v.val - j.val < 16384 := by omega
    have hcp2 : ∀ a : Fin 128, ∀ b : Fin 128, colPat.testBit (128 * a.val + b.val) = decide (b.val = 0) := by
      decide +kernel
    have hcp : ∀ k : Fin 16384, colPat.testBit k.val = decide (k.val % 128 = 0) := by
      intro k
      have hk := k.isLt
      have ha : k.val / 128 < 128 := by omega
      have hb : k.val % 128 < 128 := by omega
      have h : colPat.testBit (128 * (k.val / 128) + k.val % 128) = decide (k.val % 128 = 0) :=
        hcp2 ⟨k.val / 128, ha⟩ ⟨k.val % 128, hb⟩
      have hk2 : 128 * (k.val / 128) + k.val % 128 = k.val := by omega
      rw [hk2] at h
      exact h
    rw [hcp ⟨128 * u.val + v.val - j.val, hlt⟩]
    apply Bool.eq_iff_iff.mpr
    simp only [decide_eq_true_eq]
    constructor
    · intro hm
      apply Fin.ext
      omega
    · rintro rfl
      omega
  · simp only [decide_eq_false hle, Bool.false_and]
    symm
    apply decide_eq_false
    intro heq
    subst heq
    omega

theorem rowMask_bit (i u v : Fin 128) :
    (mask32 <<< (128 * i.val)).testBit (128 * u.val + v.val) = decide (i = u) := by
  rw [Nat.testBit_shiftLeft]
  by_cases hle : 128 * i.val ≤ 128 * u.val + v.val
  · simp only [decide_eq_true hle, Bool.true_and]
    by_cases heq : i = u
    · subst heq
      have h1 : 128 * i.val + v.val - 128 * i.val = v.val := by omega
      rw [h1, mask32_bit v.val v.isLt]
      simp
    · have hlt : i.val < u.val := by
        have hne : i.val ≠ u.val := fun h => heq (Fin.ext h)
        omega
      have hge : 128 ≤ 128 * u.val + v.val - 128 * i.val := by omega
      rw [mask32_bit_ge _ hge]
      simp [heq]
  · simp only [decide_eq_false hle, Bool.false_and]
    symm
    apply decide_eq_false
    intro heq
    subst heq
    omega

theorem initList_len : initList.length = 256 := by
  unfold initList
  rw [List.length_append, List.length_ofFn, List.length_ofFn]

theorem oneEach_len (u v : Fin 128) : (oneEach u v).length = 256 := by
  unfold oneEach
  rw [List.length_append, List.length_ofFn, List.length_ofFn]

theorem getRev_reverse (l : List ℕ) (i : ℕ) :
    getRev l.reverse l.length i = l.getD i 0 := by
  unfold getRev
  by_cases hi : i < l.length
  · simp only [hi, ↓reduceIte, List.getD_eq_getElem?_getD]
    have h1 : l.length - 1 - i < l.reverse.length := by simp; omega
    rw [List.getElem?_eq_getElem h1, List.getElem_reverse, List.getElem?_eq_getElem hi]
    have hidx : l.length - 1 - (l.length - 1 - i) = i := by omega
    simp [hidx]
  · simp only [hi, ↓reduceIte, List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_none (by omega)]
    rfl

theorem initRev_bit (u v : Fin 128) (i : ℕ) :
    (getRev initRev 256 i).testBit (128 * u.val + v.val) = (oneEach u v).getD i false := by
  have h1 : getRev initRev 256 i = initList.getD i 0 := by
    rw [← initList_len]
    exact getRev_reverse initList i
  rw [h1]
  by_cases hi : i < 256
  · by_cases h32 : i < 128
    · have hl1 : (List.ofFn (fun k : Fin 128 => mask32 <<< (128 * k.val))).length = 128 := List.length_ofFn
      have hl2 : (List.ofFn (fun k : Fin 128 => decide (k = u))).length = 128 := List.length_ofFn
      simp only [initList, oneEach, List.getD_eq_getElem?_getD]
      rw [List.getElem?_append_left (by omega), List.getElem?_append_left (by omega)]
      simp only [List.getElem?_ofFn, h32, dite_true, Option.getD_some]
      exact rowMask_bit ⟨i, h32⟩ u v
    · have hj : i - 128 < 128 := by omega
      have hl1 : (List.ofFn (fun k : Fin 128 => mask32 <<< (128 * k.val))).length = 128 := List.length_ofFn
      have hl2 : (List.ofFn (fun k : Fin 128 => decide (k = u))).length = 128 := List.length_ofFn
      simp only [initList, oneEach, List.getD_eq_getElem?_getD]
      rw [List.getElem?_append_right (by omega), List.getElem?_append_right (by omega)]
      simp only [hl1, hl2, List.getElem?_ofFn, hj, dite_true, Option.getD_some]
      exact colPat_bit u v ⟨i - 128, hj⟩
  · simp only [List.getD_eq_getElem?_getD]
    rw [List.getElem?_eq_none (by rw [initList_len]; omega), List.getElem?_eq_none (by rw [oneEach_len]; omega)]
    simp

theorem getRev_cons (v : ℕ) (rw : List ℕ) (n i : ℕ) :
    getRev (v :: rw) (n + 1) i = if i = n then v else getRev rw n i := by
  unfold getRev
  by_cases heq : i = n
  · subst heq
    simp
  · by_cases hi : i < n
    · have h1 : i < n + 1 := by omega
      have h2 : n - i = (n - 1 - i) + 1 := by omega
      simp only [heq, hi, h1, ↓reduceIte, Nat.add_sub_cancel]
      rw [h2]
      rfl
    · have h1 : ¬(i < n + 1) := by omega
      simp [heq, hi, h1]

theorem getW_cons (v : ℕ) (rw : List ℕ) (n i : ℕ) (hn : 256 ≤ n) :
    getW (v :: rw) (n + 1) i = if i = n then v else getW rw n i := by
  unfold getW
  by_cases hi : i < 256
  · have hne : i ≠ n := by omega
    simp only [hi, hne, ↓reduceIte]
  · simp only [hi, ↓reduceIte]
    exact getRev_cons v rw n i

theorem initW_bit (u v : Fin 128) (i : ℕ) :
    (getW [] 256 i).testBit (128 * u.val + v.val) = (oneEach u v).getD i false := by
  unfold getW
  by_cases hi : i < 256
  · simp only [hi, ↓reduceIte]
    have h := initRev_bit u v i
    have h1 : getRev initRev 256 i = initList.getD i 0 := by
      rw [← initList_len]
      exact getRev_reverse initList i
    rw [h1] at h
    exact h
  · simp only [hi, ↓reduceIte]
    have h2 : getRev [] 256 i = 0 := by
      unfold getRev
      simp only [hi, ↓reduceIte]
    rw [h2, List.getD_eq_getElem?_getD, List.getElem?_eq_none (by rw [oneEach_len]; omega)]
    simp

theorem step_sim (u v : Fin 128) (st : ℕ × List ℕ) (wb : List Bool) (g : Gate)
    (hlen : st.1 = wb.length) (hn : 256 ≤ st.1)
    (hsim : ∀ i, (getW st.2 st.1 i).testBit (128 * u.val + v.val) = wb.getD i false)
    (hg : goodGate g = true) :
    (stepRev st g).1 = (wb ++ [g.op.eval (g.inputs.map fun i => wb.getD i false)]).length ∧
    ∀ i, (getW (stepRev st g).2 (stepRev st g).1 i).testBit (128 * u.val + v.val) =
      (wb ++ [g.op.eval (g.inputs.map fun i => wb.getD i false)]).getD i false := by
  have hk : 128 * u.val + v.val < 16384 := by omega
  constructor
  · simp [stepRev, hlen]
  · intro i
    simp only [stepRev]
    rw [getW_cons _ _ _ _ hn]
    by_cases heq : i = st.1
    · subst heq
      simp only [↓reduceIte, List.getD_eq_getElem?_getD]
      rw [List.getElem?_append_right (by omega), hlen, Nat.sub_self]
      simp only [List.getElem?_cons_zero, Option.getD_some]
      rcases g with ⟨op, ins⟩
      cases op with
      | and =>
        rcases ins with _ | ⟨a, _ | ⟨b, _ | _⟩⟩
        · simp [goodGate] at hg
        · simp [goodGate] at hg
        · simp only [GateOp.eval, List.map, List.all, id, Bool.and_true, Nat.testBit_and]
          rw [← hlen, hsim a, hsim b]
          simp [List.getD_eq_getElem?_getD]
        · simp [goodGate] at hg
      | or =>
        rcases ins with _ | ⟨a, _ | ⟨b, _ | _⟩⟩
        · simp [goodGate] at hg
        · simp [goodGate] at hg
        · simp only [GateOp.eval, List.map, List.any, id, Bool.or_false, Nat.testBit_or]
          rw [← hlen, hsim a, hsim b]
          simp [List.getD_eq_getElem?_getD]
        · simp [goodGate] at hg
      | not =>
        rcases ins with _ | ⟨a, _ | _⟩
        · simp [goodGate] at hg
        · simp only [GateOp.eval, List.map, List.headD, Nat.testBit_xor, mask1024_bit _ hk, Bool.true_bne]
          rw [← hlen, hsim a]
          simp [List.getD_eq_getElem?_getD]
        · simp [goodGate] at hg
      | mod m => simp [goodGate] at hg
      | maj => simp [goodGate] at hg
    · simp only [heq, ↓reduceIte]
      by_cases hlt : i < wb.length
      · simp only [List.getD_eq_getElem?_getD]
        rw [List.getElem?_append_left hlt]
        simpa [List.getD_eq_getElem?_getD] using hsim i
      · have hge : ¬(i < st.1) := by omega
        have hgt : wb.length + 1 ≤ i := by omega
        have h256 : ¬(i < 256) := by omega
        simp only [getW, getRev, hge, h256, ↓reduceIte, List.getD_eq_getElem?_getD]
        rw [List.getElem?_eq_none (by simp; omega)]
        simp

theorem foldl_sim (u v : Fin 128) (gs : List Gate) (st : ℕ × List ℕ) (wb : List Bool)
    (hlen : st.1 = wb.length) (hn : 256 ≤ st.1)
    (hsim : ∀ i, (getW st.2 st.1 i).testBit (128 * u.val + v.val) = wb.getD i false)
    (hgs : ∀ g ∈ gs, goodGate g = true) :
    ∀ i, (getW (gs.foldl stepRev st).2 (gs.foldl stepRev st).1 i).testBit (128 * u.val + v.val) =
      (gs.foldl (fun w g => w ++ [g.op.eval (g.inputs.map fun i => w.getD i false)]) wb).getD i false := by
  induction gs generalizing st wb with
  | nil => exact hsim
  | cons g gs ih =>
    have h1 := step_sim u v st wb g hlen hn hsim (hgs g (List.mem_cons_self ..))
    have hn2 : 256 ≤ (stepRev st g).1 := by
      simp only [stepRev]
      omega
    exact ih (stepRev st g) _ h1.1 hn2 h1.2 (fun q hq => hgs q (List.mem_cons_of_mem _ hq))

theorem good_imp_fanin (g : Gate) (hg : goodGate g = true) :
    g.op ∈ ({GateOp.and, GateOp.or, GateOp.not} : Set GateOp) ∧ g.inputs.length ≤ 2 := by
  rcases g with ⟨op, ins⟩
  cases op with
  | and =>
    rcases ins with _ | ⟨a, _ | ⟨b, _ | _⟩⟩ <;> simp [goodGate] at hg ⊢
  | or =>
    rcases ins with _ | ⟨a, _ | ⟨b, _ | _⟩⟩ <;> simp [goodGate] at hg ⊢
  | not =>
    rcases ins with _ | ⟨a, _ | _⟩ <;> simp [goodGate] at hg ⊢
  | mod m => simp [goodGate] at hg
  | maj => simp [goodGate] at hg

theorem hgood : cktGates.all goodGate = true := by decide +kernel

theorem hfan : FanInTwo ckt := by
  intro g hg
  exact good_imp_fanin g (List.all_eq_true.mp hgood g hg)

theorem hsz : ckt.size ≤ 2046 := by decide +kernel

theorem hval :
    let st := cktGates.foldl stepRev (256, [])
    getW st.2 st.1 2299 = target1024 := by
  decide +kernel

theorem htarget_bit (u v : Fin 128) :
    target1024.testBit (128 * u.val + v.val) = (rowTbl.getD u.val 0).testBit v.val := by
  have hslice : ∀ u : Fin 128, (target1024 >>> (128 * u.val)) &&& mask32 = rowTbl.getD u.val 0 := by
    decide +kernel
  rw [← hslice u, Nat.testBit_and, mask32_bit v.val v.isLt, Bool.and_true, Nat.testBit_shiftRight]

theorem hrep : Represents (fun u v : Fin 128 => (rowTbl.getD u.val 0).testBit v.val) ckt := by
  intro u v
  have hgs : ∀ g ∈ cktGates, goodGate g = true := List.all_eq_true.mp hgood
  have hf := foldl_sim u v cktGates (256, []) (oneEach u v)
    (oneEach_len u v).symm (Nat.le_refl 256) (initW_bit u v) hgs 2299
  have hv : getW (cktGates.foldl stepRev (256, [])).2 (cktGates.foldl stepRev (256, [])).1 2299 = target1024 := hval
  rw [hv, htarget_bit u v] at hf
  exact hf.symm

end PEqualNP.Outside.L_meta_19035_aux

